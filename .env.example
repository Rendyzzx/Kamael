# ===== API sumber (server-side only, jangan pakai NEXT_PUBLIC_) =====
API_BASE_URL=https://www.sankavollerei.web.id

# ===== Redis (Upstash; server-side only) =====
# Buat gratis di https://console.upstash.com -> REST API.
# Tanpa ini website tetap berjalan penuh; fitur user (history/favorites/
# continue watching) otomatis nonaktif dan cache memakai Next.js saja.
REDIS_URL=
REDIS_TOKEN=

# ===== Auth.js (Google OAuth; server-side only) =====
# Google Cloud Console -> Credentials -> OAuth Client ID (Web application).
# Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://<domain-anda>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret untuk menandatangani session JWT (min. 16 karakter acak).
AUTH_SECRET=
# Di Vercel set: AUTH_TRUST_HOST=true (atau set AUTH_URL ke domain produksi).

# ===== Publik =====
# URL publik situs untuk metadata canonical/OpenGraph/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login tester (QA) — HANYA aktif di development. Di produksi butuh
# ENABLE_TESTER_LOGIN=true juga. TANPA TESTER_CODE yang terisi, provider
# tester tidak diregistrasi sama sekali (tidak ada kode default hardcoded).
TESTER_CODE=
ENABLE_TESTER_LOGIN=

# ================= MULTI-PLATFORM & ADMIN (baru) =================

# ===== Admin bypass maintenance (server-side) =====
# Email akun Google yang boleh melihat website saat maintenance aktif.
# Dipisah koma. Bypass dibaca dari SESSION server, bukan query param.
ADMIN_EMAILS=

# ===== Telegram Bot Admin =====
# Token dari @BotFather. JANGAN pernah di-commit atau dikirim ke client.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID yang boleh memakai command admin (bukan username).
# Cara lihat ID: chat @userinfobot di Telegram. Dipisah koma.
ADMIN_TELEGRAM_IDS=
# Secret token acak (min. 16 karakter) — dipakai saat setWebhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<domain>/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# ===== Firebase Cloud Messaging (notification Android) =====
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. HANYA untuk backend (env Vercel) — JANGAN masuk ke APK.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Isi dengan private key PEM; karakter \n dibiarkan sebagai literal "\n".
FIREBASE_PRIVATE_KEY=

# ===== Versi aplikasi Android (dicek app saat startup) =====
APP_LATEST_VERSION=1.0.0
APP_MINIMUM_VERSION=1.0.0
APP_DOWNLOAD_URL=
# true = paksa update untuk SEMUA versi (keadaan darurat saja).
APP_FORCE_UPDATE=false

# ===== Identitas Android =====
ANDROID_PACKAGE_NAME=id.my.id.cyronime.app
